{
  "$schema": "https://schema.tauri.app/config/2",
  "mainBinaryName": "Time",
  "productName": "Time",
  "version": "0.2.0",
  "identifier": "time.megumu.me",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Time",
        "width": 1120,
        "height": 680,
        "minWidth": 320,
        "minHeight": 180,
        "center": true,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "backgroundColor": [251, 251, 248, 255]
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "macOS": {
      "bundleName": "Time"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "__TAURI_UPDATER_PUBKEY__",
      "endpoints": [
        "https://github.com/niiharamegumu/time/releases/latest/download/latest.json"
      ]
    }
  }
}
