{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "time",
  "version": "0.1.0",
  "identifier": "time.megumu.me",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Time",
        "width": 520,
        "height": 260,
        "minWidth": 460,
        "minHeight": 220,
        "center": true,
        "alwaysOnTop": true,
        "resizable": true,
        "titleBarStyle": "Transparent",
        "backgroundColor": [255, 255, 255, 255]
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
