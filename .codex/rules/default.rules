# Local implementation work can proceed without repeated approval prompts.
prefix_rule(
    pattern = ["git", "add"],
    decision = "allow",
    justification = "Staging local changes is allowed for normal coding workflows.",
    match = [
        "git add .",
        "git add src/App.tsx",
    ],
    not_match = [
        "git commit -m test",
    ],
)

prefix_rule(
    pattern = ["git", "commit"],
    decision = "allow",
    justification = "Creating local commits is allowed for normal coding workflows.",
    match = [
        "git commit -m test",
        "git commit --amend --no-edit",
    ],
    not_match = [
        "git push origin main",
    ],
)

prefix_rule(
    pattern = ["git", "checkout", "-b"],
    decision = "allow",
    justification = "Creating a local topic branch is allowed.",
    match = [
        "git checkout -b feature/example",
    ],
    not_match = [
        "git checkout main",
    ],
)

prefix_rule(
    pattern = ["git", "switch", "-c"],
    decision = "allow",
    justification = "Creating a local topic branch is allowed.",
    match = [
        "git switch -c feature/example",
    ],
    not_match = [
        "git switch main",
    ],
)

prefix_rule(
    pattern = ["git", "push"],
    decision = "allow",
    justification = "Pushing a reviewed feature branch is allowed in this repository workflow.",
    match = [
        "git push origin HEAD",
        "git push -u origin feature/example",
    ],
    not_match = [
        "git push origin main",
        "git push --force",
        "git push --force-with-lease",
    ],
)

prefix_rule(
    pattern = ["gh", "pr", "create"],
    decision = "allow",
    justification = "Creating a pull request for reviewed local changes is allowed.",
    match = [
        "gh pr create --title test --body body",
    ],
    not_match = [
        "gh pr view 123",
    ],
)


prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "forbidden",
    justification = "Do not discard work with `git reset --hard`; use a non-destructive alternative instead.",
    match = [
        "git reset --hard",
        "git reset --hard HEAD~1",
    ],
    not_match = [
        "git reset HEAD -- src/App.tsx",
    ],
)

prefix_rule(
    pattern = ["git", "clean", "-fd"],
    decision = "forbidden",
    justification = "Do not bulk-delete untracked files with `git clean -fd`; remove specific files intentionally instead.",
    match = [
        "git clean -fd",
    ],
    not_match = [
        "git clean -n",
    ],
)

prefix_rule(
    pattern = ["rm", "-rf"],
    decision = "forbidden",
    justification = "Recursive forced deletes should stay blocked; remove files with a narrower command instead.",
    match = [
        "rm -rf tmp/build-cache",
    ],
    not_match = [
        "rm README.md",
    ],
)
